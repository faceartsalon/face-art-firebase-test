<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>FACE ART · Firebase Connection Test</title>
<style>
:root{color-scheme:dark;--gold:#d6b15d;--bg:#111;--panel:#1b1b1b;--muted:#aaa;--line:#393939}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(145deg,#090909,#1d1a12);color:#f5f1e7;font:16px system-ui,Arial,sans-serif;min-height:100vh;display:grid;place-items:center;padding:20px}
.card{width:min(100%,520px);background:var(--panel);border:1px solid #5a4825;border-radius:18px;padding:24px;box-shadow:0 16px 50px #0008}
h1{font-size:22px;color:var(--gold);margin:0 0 6px}.sub{color:var(--muted);font-size:13px;margin:0 0 22px}
.tag{display:inline-block;border:1px solid #6c5628;color:var(--gold);border-radius:20px;padding:5px 10px;font-size:12px;margin-bottom:14px}
label{display:block;color:#ddd;font-size:13px;margin:13px 0 6px}input{width:100%;padding:13px;border-radius:9px;border:1px solid var(--line);background:#101010;color:#fff;font-size:16px}
button{width:100%;padding:13px;border:0;border-radius:9px;background:var(--gold);color:#17130a;font-weight:700;font-size:15px;margin-top:12px}
button.secondary{background:#292929;color:#eee;border:1px solid #555}button:disabled{opacity:.5}
.status{margin-top:18px;padding:13px;border:1px solid var(--line);border-radius:10px;background:#121212;white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;min-height:72px}
.small{font-size:12px;color:var(--muted);line-height:1.5;margin-top:15px}.ok{color:#9cdb9c}.err{color:#ff9d91}.hidden{display:none}
</style>
</head>
<body>
<main class="card">
<div class="tag">SAFE TEST · READ ONLY · NO SALON DATA TRANSFER</div>
<h1>FACE ART Firebase Connection</h1>
<p class="sub">Connection diagnosis — verifies the confirmed Firebase project, current website domain, owner sign-in state, and the owner profile read. Read-only: no salon records are written, edited, or transferred.</p>
<section id="signedOut">
<label for="email">Owner email</label><input id="email" type="email" autocomplete="username" value="faceartsalon@gmail.com" placeholder="Owner email">
<label for="password">Password</label><input id="password" type="password" autocomplete="current-password" placeholder="Firebase Auth password">
<button id="emailLogin">Sign in with email</button><button id="googleLogin" class="secondary">Continue with Google</button>
</section>
<section id="signedIn" class="hidden">
<p id="identity"></p>
<button id="readProfile">Test owner profile read</button>
<button id="signOut" class="secondary">Sign out</button>
</section>
<div id="status" class="status">Initializing Firebase…</div>
<p class="small">Use only the authorized owner account. Never share your password. This test reads exactly /salons/face-art/users/{your signed-in UID}. It does not read branches, bills, customers, staff, inventory, or any other salon collection. No document is changed.</p>
</main>
<script type="module">
import { initializeApp } from 'https://www.gstatic.com/firebasejs/13.3.0/firebase-app.js';
import { getAuth, onAuthStateChanged, signInWithEmailAndPassword, GoogleAuthProvider, signInWithPopup, signOut } from 'https://www.gstatic.com/firebasejs/13.3.0/firebase-auth.js';
import { getFirestore, doc, getDoc } from 'https://www.gstatic.com/firebasejs/13.3.0/firebase-firestore.js';

const cfg={
 apiKey:'AIzaSyDDMrc0xLNP9Sq497UTc-ITs-_88IFh6yM',
 authDomain:'faceart-6ec98.firebaseapp.com',
 projectId:'faceart-6ec98',
 storageBucket:'faceart-6ec98.firebasestorage.app',
 messagingSenderId:'446197553621',
 appId:'1:446197553621:web:92a7b8caf8c61891d8c55c',
 measurementId:'G-1V6BBY79BB'
};
const $=id=>document.getElementById(id);
const status=(msg,kind='')=>{$('status').textContent=msg;$('status').className='status '+kind;};
let auth,db;
try{
 const app=initializeApp(cfg);
 auth=getAuth(app);
 db=getFirestore(app);
 status('FIREBASE SDK INITIALIZED\nProject: '+cfg.projectId+'\nWebsite: '+location.hostname+'\nAPI key fingerprint: '+cfg.apiKey.slice(0,10)+'…'+cfg.apiKey.slice(-6)+'\nWaiting for owner authentication…','ok');
}catch(e){status('Initialization failed: '+(e.code||e.message),'err');}

if(auth){
 onAuthStateChanged(auth,user=>{
  if(user){
   $('signedOut').classList.add('hidden');
   $('signedIn').classList.remove('hidden');
   $('identity').textContent='Signed in as: '+(user.email||'(no email)')+'\nUID: '+user.uid+'\nProvider: '+(user.providerData.map(p=>p.providerId).join(', ')||'unknown');
   status('AUTHENTICATION SUCCESS\nOwner signed in. Tap “Test owner profile read” to check the Firestore permission.','ok');
  }else{
   $('signedOut').classList.remove('hidden');
   $('signedIn').classList.add('hidden');
   status('Firebase initialized.\nPlease sign in with the authorized owner account.');
  }
 });
 $('emailLogin').onclick=async()=>{
  const email=$('email').value.trim(),password=$('password').value;
  if(!email||!password){status('Enter the owner email and password.','err');return;}
  $('emailLogin').disabled=true;
  try{await signInWithEmailAndPassword(auth,email,password);}
  catch(e){status('SIGN-IN FAILED\nCode: '+(e.code||'unknown')+'\nMessage: '+(e.message||'')+'\nProject: '+cfg.projectId+'\nWebsite: '+location.hostname+'\nAPI key fingerprint: '+cfg.apiKey.slice(0,10)+'…'+cfg.apiKey.slice(-6)+'\n\nIf code is auth/api-key-not-valid, this is an API key / API restriction issue, not a Firestore owner-role or document-status issue. Do not change Firestore rules.','err');}
  finally{$('emailLogin').disabled=false;}
 };
 $('googleLogin').onclick=async()=>{
  try{await signInWithPopup(auth,new GoogleAuthProvider());}
  catch(e){status('GOOGLE SIGN-IN FAILED\nCode: '+(e.code||'unknown')+'\nMessage: '+(e.message||'')+'\nProject: '+cfg.projectId+'\nWebsite: '+location.hostname+'\n\nIf code is auth/api-key-not-valid, investigate the API key restrictions / Identity Toolkit API. Do not change Firestore rules.','err');}
 };
 $('readProfile').onclick=async()=>{
  const user=auth.currentUser;
  if(!user){status('No signed-in user. Sign in first.','err');return;}
  $('readProfile').disabled=true;
  status('Reading your owner profile document…');
  try{
   const ref=doc(db,'salons','face-art','users',user.uid);
   const snap=await getDoc(ref);
   if(!snap.exists()){
    status('FIRESTORE REACHED, BUT PROFILE NOT FOUND\nExpected document: /salons/face-art/users/'+user.uid+'\nNo data was changed. Check that this exact owner UID has a profile document.','err');
    return;
   }
   const data=snap.data();
   const role=String(data.role||'(missing)');
   const state=String(data.status||'(missing)');
   status('FIRESTORE READ SUCCESS\nDocument: /salons/face-art/users/'+user.uid+'\nrole: '+role+'\nstatus: '+state+'\n\nRead-only test completed. No document was changed.',role==='owner'&&state==='active'?'ok':'err');
  }catch(e){
   status('FIRESTORE READ FAILED\nCode: '+(e.code||'unknown')+'\nMessage: '+(e.message||'')+'\nProject: '+cfg.projectId+'\nWebsite: '+location.hostname+'\nSigned-in UID: '+user.uid+'\n\nNo data was changed. Do not loosen Firestore rules.','err');
  }finally{$('readProfile').disabled=false;}
 };
 $('signOut').onclick=async()=>{try{await signOut(auth);}catch(e){status('Sign-out failed: '+(e.code||e.message),'err');}};
}
</script>
</body>
</html>